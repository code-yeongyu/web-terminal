{
  "name": "web-terminal",
  "version": "0.1.0",
  "description": "Mobile-first self-hosted web terminal powered by Ghostty's VT engine (WASM), with disconnect-surviving sessions, a file explorer, and herdr integration",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun run src/server/index.ts",
    "dev": "bun --hot src/server/index.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "build": "bun build src/server/index.ts --target bun --outdir dist"
  },
  "license": "MIT",
  "dependencies": {
    "@openclaw/libterminal": "0.4.0",
    "ghostty-web": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "playwright": "^1.62.1"
  }
}
